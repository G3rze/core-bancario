# Variables para docker-compose (copiar a .env en esta carpeta).
WEB_PORT=4200

DB_USER=postgres
DB_PASSWORD=postgres

# Minimo 32 caracteres; genera uno propio: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=7200000

# Usuarios iniciales (se crean al arrancar si no existen). DUI 00000000-0,
# password de al menos 6 caracteres.
BOOTSTRAP_GERENTE_DUI=00000001-1
BOOTSTRAP_GERENTE_NOMBRE=Gerente General
BOOTSTRAP_GERENTE_PASSWORD=cambia-esta-clave
BOOTSTRAP_ADMIN_DUI=00000002-2
BOOTSTRAP_ADMIN_NOMBRE=Administrador
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave
