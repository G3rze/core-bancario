digraph Capas {
  graph [rankdir=TB, fontname="Helvetica", labelloc=t, fontsize=18, label="Core Bancario - Arquitectura por capas y dependencias", nodesep=0.35, ranksep=0.6, compound=true];
  node  [shape=box, fontname="Helvetica", fontsize=10, style="filled,rounded", fillcolor="#f5f9ff", color="#1565c0"];
  edge  [fontname="Helvetica", fontsize=9, color="#455a64"];

  subgraph cluster_ui { label="Frontend (Angular 20)"; style=rounded; color="#2e7d32";
    ui [label="components (login, registro, mis-cuentas,\ncuenta-detalle, ventanilla, reportes, admin)\n+ guards / interceptor JWT", fillcolor="#e8f5e9", color="#2e7d32"];
    uisvc [label="services (AuthService, CuentaService,\nVentanillaService, ReporteService...)", fillcolor="#e8f5e9", color="#2e7d32"];
  }
  subgraph cluster_sec { label="Seguridad (Spring Security + JWT)"; style=rounded; color="#6a1b9a";
    sec [label="SecurityConfig · JwtAuthenticationFilter · JwtService\n@PreAuthorize · AutorizacionCuentas (interfaz)", fillcolor="#f3e5f5", color="#6a1b9a"];
  }
  subgraph cluster_api { label="Controller (REST /api)"; style=rounded; color="#1565c0";
    ctl [label="AuthController · ClienteController · CuentaController\nVentanillaController · EmpleadoController\nAdminUsuarioController · ReporteController"];
    exh [label="NegocioExceptionHandler (400/404)\nSeguridadExceptionHandler (401/403)\nPersistenciaExceptionHandler (409/503)", fillcolor="#fff3e0", color="#ef6c00"];
  }
  subgraph cluster_svc { label="Service (interfaces + impl)"; style=rounded; color="#1565c0";
    svc [label="«interface» CuentaService · ClienteService · EmpleadoService\nAuthService · ReporteService · UsuarioAdminService"];
    aux [label="HistorialService (Map+TreeSet) · LimiteDiarioService\nNotificacionService (Queue) · CuentaFactory (EnumMap)"];
    sch [label="CalculoInteresScheduler\n@Scheduled (hilo periodico)", fillcolor="#fff3e0", color="#ef6c00"];
  }
  subgraph cluster_dao { label="DAO / Repositorios"; style=rounded; color="#1565c0";
    jpa [label="ClienteRepository · CuentaRepository (FOR UPDATE)\nEmpleadoRepository  (Spring Data JPA)"];
    dat [label="«interface» Dao<T>  ←  ArchivoDao<T>\nTransaccionDAO (.dat serializado)", fillcolor="#fff8e1", color="#ef6c00"];
  }
  subgraph cluster_dom { label="Model"; style=rounded; color="#1565c0";
    dom [label="entity (Usuario, Cuenta, Transaccion, ...)\ndto (records)"];
  }
  pg  [label="PostgreSQL 16\n(HikariCP)", shape=cylinder, fillcolor="#e0f7fa", color="#006064"];
  dtf [label="datos/transacciones.dat", shape=note, fillcolor="#fff8e1", color="#ef6c00"];

  ui -> uisvc;
  uisvc -> sec [label="HTTP + Bearer"];
  sec -> ctl;
  ctl -> svc [label="depende de interfaces"];
  ctl -> exh [style=dashed, arrowhead=none];
  svc -> aux; sch -> svc;
  svc -> jpa; svc -> dat;
  jpa -> dom; svc -> dom;
  jpa -> pg; dat -> dtf;
}
