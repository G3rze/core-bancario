digraph Dominio {
  graph [rankdir=BT, fontname="Helvetica", labelloc=t, fontsize=18, label="Core Bancario - Diagrama de clases (modelo de dominio)", nodesep=0.5, ranksep=0.7, splines=ortho];
  node  [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#f5f9ff", color="#1565c0"];
  edge  [fontname="Helvetica", fontsize=9, color="#455a64"];

  Usuario [label="{«abstract»\nUsuario|- id: Long\l- dui: String\l- nombre: String\l- direccion: String\l- telefono: String\l- fechaRegistro: LocalDateTime\l- activo: boolean\l- passwordHash: String\l|+ getRol(): Rol «abstract»\l+ validarPassword(intento, encoder): boolean\l+ activar() / desactivar()\l}", fillcolor="#e3f2fd"];
  Cliente [label="{Cliente|- numeroCliente: String\l- tipo: TipoCliente\l- cuentas: List\<Cuenta\>\l|+ agregarCuenta(Cuenta)\l+ eliminarCuenta(String)\l}"];
  Empleado [label="{«abstract»\nEmpleado|- codigoEmpleado: String\l- sucursal: String\l- fechaContratacion: LocalDate\l|+ getNivelAutorizacion(): String «abstract»\l}", fillcolor="#e3f2fd"];
  Cajero [label="{Cajero|- cajaAsignada: String\l|nivel = BASICO\l}"];
  Gerente [label="{Gerente|- montoMaximoAprobacion: BigDecimal\l|nivel = SUPERVISOR\l}"];
  Administrador [label="{Administrador|nivel = ADMIN\l}"];
  Cliente -> Usuario [arrowhead=empty];
  Empleado -> Usuario [arrowhead=empty];
  Cajero -> Empleado [arrowhead=empty];
  Gerente -> Empleado [arrowhead=empty];
  Administrador -> Empleado [arrowhead=empty];

  Cuenta [label="{«abstract»\nCuenta|- id: Long\l- numeroCuenta: String\l- saldo: BigDecimal\l- montoMinimoApertura: BigDecimal\l- limiteRetiroDiario: BigDecimal\l- fechaApertura: LocalDateTime\l- estado: EstadoCuenta\l- version: long «@Version»\l|+ depositar(monto)\l+ retirar(monto)\l# ajustarSaldo(delta)\l+ calcularInteres(): BigDecimal «abstract»\l+ getTipoCuenta(): String «abstract»\l}", fillcolor="#e3f2fd"];
  CuentaAhorros [label="{CuentaAhorros|tasa 2%\lmin 25 / limite 500\l|+ calcularInteres()\l}"];
  CuentaCorriente [label="{CuentaCorriente|sobregiro 200\lmin 100 / limite 2000\l|+ calcularInteres() = 0\l}"];
  CuentaPlazoFijo [label="{CuentaPlazoFijo|- plazoMeses: int\l- fechaVencimiento\ltasa 6%, min 500\l|+ calcularInteres()\l}"];
  CuentaAhorros -> Cuenta [arrowhead=empty];
  CuentaCorriente -> Cuenta [arrowhead=empty];
  CuentaPlazoFijo -> Cuenta [arrowhead=empty];
  Cliente -> Cuenta [arrowhead=odiamond, taillabel="1", headlabel="0..*", label="  titular de"];

  Transaccion [label="{«abstract»\nTransaccion|- numeroTransaccion: String\l- monto: BigDecimal\l- fecha: LocalDateTime\l- estado: EstadoTransaccion\l- cajero: Cajero\l|+ ejecutar() «final, metodo plantilla»\l+ validarTransaccion(): boolean «abstract»\l# aplicar() «abstract»\l+ generarComprobante(): String «abstract»\l}", fillcolor="#e3f2fd"];
  Deposito [label="{Deposito|- cuenta (destino)\l}"];
  Retiro [label="{Retiro|- cuenta (origen)\l}"];
  Transferencia [label="{Transferencia|- origen, destino\l}"];
  Deposito -> Transaccion [arrowhead=empty];
  Retiro -> Transaccion [arrowhead=empty];
  Transferencia -> Transaccion [arrowhead=empty];
  Transaccion -> Cuenta [arrowhead=vee, style=dashed, label="opera sobre"];
  Transaccion -> Cajero [arrowhead=vee, style=dashed, label="0..1 cajero"];

  RegistroTransaccion [label="{RegistroTransaccion «Serializable»|numeroTransaccion, tipo, monto, fecha, estado\lnumeroCuentaOrigen / Destino\lcodigoEmpleadoCajero\lsaldoPosterior Origen / Destino\lcomprobante\l|+ desde(Transaccion)\l}", fillcolor="#fff8e1", color="#ef6c00"];
  RegistroTransaccion -> Transaccion [arrowhead=vee, style=dashed, label="log de"];

  { rank=same; Deposito; Retiro; Transferencia; }
  { rank=same; CuentaAhorros; CuentaCorriente; CuentaPlazoFijo; }
}
