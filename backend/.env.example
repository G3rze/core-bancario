SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:4200
LOG_LEVEL=INFO

# Cada cuanto corre la capitalizacion de intereses (ms). Default 24h;
# bajarlo para verla correr en vivo durante una demo (p. ej. 30000 = 30s).
INTERES_PERIODO_MS=86400000

# Postgres (Cliente/Cuenta/Empleado; Transaccion sigue en backend/datos/*.dat
# como log). Apunta a un contenedor Docker local con la base ya creada.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_bancario
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (Spring Security stateless). JWT_SECRET: minimo 32 caracteres, generar
# uno propio (p. ej. `openssl rand -base64 48`); nunca commitear el real.
# JWT_EXPIRATION_MS: vigencia del token (default 2h).
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=7200000
